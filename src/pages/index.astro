---
import Base from '../layouts/Base.astro';
import ReferenceGallery from '../components/ReferenceGallery.astro';
import { quests } from '../data';
const categories=[
{key:'CREATE',num:'01',icon:'✦',title:'CREATE',sub:'Etwas Neues schaffen',desc:'Aus einer Idee wird ein Produkt, das wirklich funktioniert.',theme:'create'},
{key:'IMPROVE',num:'02',icon:'⚙',title:'IMPROVE',sub:'Besser arbeiten',desc:'Weniger Reibung, weniger Routine, mehr Wirkung.',theme:'improve'},
{key:'EMPOWER',num:'03',icon:'↗',title:'EMPOWER',sub:'Ihr Team stärken',desc:'Erfahrung und Umsetzungskraft genau dort, wo sie fehlen.',theme:'empower'},
{key:'EVOLVE',num:'04',icon:'◇',title:'EVOLVE',sub:'Das nächste Level erreichen',desc:'Klarheit schaffen, Projekte retten und Wachstum ermöglichen.',theme:'evolve'}
];
---
<Base title="Player Two | Your Mission. My Tech Skills." description="Ihr Technologie-Partner für Softwareentwicklung, KI, Automatisierung und digitale Produkte. Persönlich aus Landsberg am Lech – deutschlandweit.">
<section class="hero" aria-labelledby="hero-title"><div class="hero-art" aria-hidden="true"></div><div class="hero-vignette" aria-hidden="true"></div><div class="wrap hero-content"><p class="eyebrow hero-status"><span class="status-dot"></span> CO-OP MODE ENABLED <span class="status-divider">/</span> LANDSBERG AM LECH</p><h1 id="hero-title">YOUR MISSION.<br/><span>MY TECH SKILLS.</span></h1><p class="hero-lead">Sie haben die Mission. Ich bringe Strategie, Produktdenken, Softwareentwicklung und KI mit – und setze mit Ihnen um.</p><div class="hero-actions"><a class="btn" href="/kontakt">Projekt besprechen <span aria-hidden="true">↗</span></a><a class="btn alt" href="#quests">Quest auswählen <span aria-hidden="true">↓</span></a></div><div class="player-bar"><div><span class="player-key">P1</span><span>IHR BUSINESS</span></div><span class="player-link">✕</span><div><span class="player-key player-key-alt">P2</span><span>IHR TECH-PARTNER</span></div></div></div><div class="hero-bottom" aria-hidden="true"><span>PRESS START TO COLLABORATE</span><span>↓ SCROLL TO EXPLORE</span></div></section>
<div class="wrap"><ReferenceGallery compact /></div>
<section class="section quests-section" id="quests"><div class="wrap"><div class="section-top"><div><p class="eyebrow">01 / QUEST BOARD</p><h2>WAS IST IHRE <span class="text-mint">MISSION?</span></h2></div><p class="section-intro">Sie müssen noch nicht wissen, welche Technologie Sie brauchen. Wählen Sie einfach die Herausforderung, die Sie lösen möchten.</p></div><div class="quest-grid">{categories.map(c=><article class={`quest-card ${c.theme}`}><div class="quest-art" aria-hidden="true"><img src={`/quest-${c.theme}.webp`} alt="" loading="lazy" width="345" height="147"/><span class="quest-number">QUEST {c.num}</span></div><div class="quest-body"><p class="eyebrow">{c.title} / {c.num}</p><h3>{c.sub}</h3><p class="muted">{c.desc}</p><div class="quest-links">{quests.filter(q=>q.group===c.key).map(q=><a href={`/quests/${q.slug}/`}>{q.de}<span aria-hidden="true">↗</span></a>)}</div></div></article>)}</div></div></section>
<section class="section partner-section"><div class="wrap partner-layout"><div class="partner-graphic" aria-hidden="true"><div class="hud-label">PLAYER TWO // CHARACTER SELECT</div><div class="character-symbol">P<span>2</span></div><div class="hud-bottom"><span>CLASS: TECH PARTNER</span><span>XP: 25+ YEARS</span></div></div><div><p class="eyebrow">02 / YOUR CO-OP PARTNER</p><h2>STRATEGIE IM KOPF.<br/><span class="text-mint">CODE IN DER HAND.</span></h2><p class="muted text-lg mt-6">Ich verbinde unternehmerisches Denken, Produktstrategie und technische Umsetzung. Statt langer Übergaben bekommen Sie einen erfahrenen Ansprechpartner, der mitdenkt und selbst anpackt.</p><div class="stat-row"><div><strong>25+</strong><span>JAHRE SOFTWARE</span></div><div><strong>20+</strong><span>JAHRE KI-ERFAHRUNG</span></div><div><strong>1</strong><span>DIREKTER PARTNER</span></div></div><a class="btn alt mt-7" href="/ueber-mich">Player Two kennenlernen ↗</a></div></div></section>
<section class="section process-section"><div class="wrap"><p class="eyebrow">03 / HOW WE PLAY</p><h2>VON DER IDEE <span class="text-mint">ZUR LÖSUNG.</span></h2><p class="muted mt-4 max-w-2xl">Kein kompliziertes Regelwerk. Ein klarer Weg von Ihrer Herausforderung zur funktionierenden Lösung.</p><div class="steps">{[{n:'01',title:'VERSTEHEN',desc:'Ziele, Kontext und echte Probleme erfassen.'},{n:'02',title:'PLANEN',desc:'Prioritäten und den richtigen Lösungsweg festlegen.'},{n:'03',title:'UMSETZEN',desc:'Bauen, testen und gemeinsam verbessern.'},{n:'04',title:'WEITERKOMMEN',desc:'Einführen, lernen und gezielt ausbauen.'}].map(s=><div class="step reveal"><span class="step-num">{s.n}</span><h3>{s.title}</h3><p>{s.desc}</p></div>)}</div><div class="mission-complete">◈ &nbsp; LEVEL UP: AUS EINER IDEE WIRD WIRKUNG &nbsp; ◈</div></div></section>
<section class="section missions-section" id="missions"><div class="wrap"><div class="section-top"><div><p class="eyebrow">04 / COMPLETED MISSIONS</p><h2>MISSION LOG<span class="text-mint">.</span></h2></div><p class="section-intro">Hier zeigen wir künftig ausgewählte Projekte und konkrete Ergebnisse. Bis dahin: Platzhalter statt erfundener Referenzen.</p></div><div class="mission-grid">{[1,2,3].map(n=><article class="mission-card reveal"><div class="mission-placeholder"><span class="placeholder-symbol">◇</span><span class="placeholder-label">CLASSIFIED / COMING SOON</span></div><div class="mission-copy"><p class="eyebrow">MISSION 0{n} / PLATZHALTER</p><h3>Projektbeispiel folgt</h3><p class="muted">Problem, Umsetzung und nachvollziehbares Ergebnis werden ergänzt.</p></div></article>)}</div></div></section>
<section class="section cta-section"><div class="wrap cta-inner"><p class="eyebrow">READY, PLAYER ONE?</p><h2>GEMEINSAM INS <span class="text-mint">NÄCHSTE LEVEL.</span></h2><p>Ob erste Idee oder festgefahrenes Projekt: Erzählen Sie mir, was Sie vorhaben.</p><a class="btn" href="/kontakt">Mission starten ↗</a><span class="cta-foot">NO BOSS FIGHTS. JUST GOOD SOLUTIONS.</span></div></section>
</Base>
