---
import '../styles/global.css';
const {title='Player Two | Ihr Technologie-Partner',description='Player Two: Software, KI, Automatisierung und Produktentwicklung aus Landsberg am Lech.'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).toString();
---
<!doctype html><html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0b1221"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><title>{title}</title></head><body><header class="site-header"><nav class="wrap site-nav" aria-label="Hauptnavigation"><a href="/" class="brand" aria-label="Player Two – Startseite">PLAYER <span>TWO</span><i>.</i></a><div class="nav-links"><a href="/#quests">Quests</a><a href="/#missions">Missions</a><a href="/ueber-mich">Über mich</a><a href="/kontakt" class="nav-contact">Projekt besprechen ↗</a></div></nav></header><main><slot/></main><footer class="site-footer"><div class="wrap footer-inner"><span>© {new Date().getFullYear()} PLAYER TWO · LANDSBERG AM LECH</span><div><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a><a href="/kontakt">Kontakt</a></div></div></footer><style>.site-header{position:absolute;z-index:10;top:0;left:0;right:0;background:#091525b8;border-bottom:1px solid #c5ffeb24;backdrop-filter:blur(12px)}.site-nav{min-height:77px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{white-space:nowrap;font:900 1.65rem 'Barlow Condensed',Impact,sans-serif;letter-spacing:.04em}.brand span{color:#a5ffdb}.brand i{color:#77e8ee;font-style:normal}.nav-links{display:flex;align-items:center;gap:28px;font-size:.78rem;font-weight:800}.nav-links a:hover{color:#a5ffdb}.nav-contact{padding:10px 14px;border:1px solid #a5ffdb;color:#a5ffdb}.site-footer{background:#091321;border-top:1px solid #34485d;padding:31px 0}.footer-inner{display:flex;justify-content:space-between;gap:25px;flex-wrap:wrap;color:#9db1c4;font-size:.7rem;letter-spacing:.06em}.footer-inner>div{display:flex;gap:23px}.footer-inner a:hover{color:#a5ffdb}@media(max-width:680px){.site-nav{min-height:69px;align-items:center}.brand{font-size:1.35rem}.nav-links{gap:13px;font-size:.68rem}.nav-links a:nth-child(2),.nav-links a:nth-child(3){display:none}.nav-contact{padding:9px 10px}.footer-inner{font-size:.65rem}}</style><script>
const targets = document.querySelectorAll('.reveal');
if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
 const observer = new IntersectionObserver((entries) => {for (const entry of entries) {if(entry.isIntersecting){entry.target.classList.add('in-view');observer.unobserve(entry.target)}}}, {threshold:.08});
 targets.forEach(el => observer.observe(el));
} else {targets.forEach(el => el.classList.add('in-view'));}
</script></body></html>
